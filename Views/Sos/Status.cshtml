@model List<ResQPaw.Models.SOSViewModel>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SOS Status - ResQPaw</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Status.css" asp-append-version="true" />
</head>
<body class="min-h-screen status-bg">
    <div class="min-h-screen py-8 px-4">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="main-title">My SOS Requests</h1>
                <p class="section-subtitle">Track the status of your emergency animal rescue requests</p>
            </div>

            <!-- SOS Requests Container -->
            <div id="sosContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                @foreach (var sos in Model)
                {
                    <div class="glass-card sos-card" id="sos-@sos.Id">
                        <div class="card-content">
                            <!-- Header Section -->
                            <div class="card-header">
                                <h3 class="card-title">
                                    @sos.AnimalType - @sos.EmergencyType
                                </h3>
                                <div class="status-badge @GetStatusClass(sos.Status)">
                                    @sos.Status
                                </div>
                            </div>

                            <!-- Reporter Info -->
                            <div class="reporter-info">
                                <div class="info-item">
                                    <i class="fas fa-user mr-2"></i>
                                    <span>@sos.ReporterName</span>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-phone mr-2"></i>
                                    <span>@sos.ReporterPhone</span>
                                </div>
                            </div>

                            <!-- Description -->
                            <p class="card-description">@sos.Description</p>

                            <!-- Location and Time -->
                            <div class="details-grid">
                                <div class="detail-item">
                                    <i class="fas fa-map-marker-alt mr-2"></i>
                                    <span class="detail-label">Location:</span>
                                    <span class="detail-value">@sos.Location</span>
                                </div>
                                <div class="detail-item">
                                    <i class="fas fa-clock mr-2"></i>
                                    <span class="detail-label">Time:</span>
                                    <span class="detail-value">@sos.CreatedAt.ToLocalTime().ToString("g")</span>
                                </div>
                            </div>

                            <!-- Media Files -->
                            @if (!string.IsNullOrEmpty(sos.MediaPaths))
                            {
                                var mediaList = sos.MediaPaths.Split(',');
                                <div class="media-gallery">
                                    <p class="media-label">Attached Media:</p>
                                    <div class="media-grid">
                                        @foreach (var path in mediaList)
                                        {
                                            <img src="@path" alt="SOS Media" class="media-image" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Empty State -->
            @if (!Model.Any())
            {
                <div class="glass-card empty-state">
                    <div class="empty-content">
                        <i class="fas fa-inbox empty-icon"></i>
                        <h3 class="empty-title">No SOS Requests Found</h3>
                        <p class="empty-text">You haven't submitted any emergency rescue requests yet.</p>
                        <a href="/SOS/Send" class="action-btn">
                            <i class="fas fa-plus mr-2"></i>
                            Submit New SOS
                        </a>
                    </div>
                </div>
            }

            <!-- Live Alerts Container -->
            <div id="alerts" class="fixed top-4 right-4 z-50 space-y-3 max-w-sm"></div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/Status.js" asp-append-version="true"></script>
</body>
</html>

@functions {
    public string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "status-pending",
            "accepted" => "status-accepted", 
            "contacted" => "status-contacted",
            "completed" => "status-completed",
            _ => "status-default"
        };
    }
}