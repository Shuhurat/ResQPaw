@model List<ResQPaw.Models.SOSViewModel>
@{
    ViewData["Title"] = "Admin SOS Monitor";
}

<h2 class="mb-4 text-center text-danger">🚨 Live SOS Monitor (Admin)</h2>

<table class="table table-bordered table-striped text-center">
    <thead class="table-dark">
        <tr>
            <th>Customer</th>
            <th>Emergency Type</th>
            <th>Animal Type</th>
            <th>Condition</th>
            <th>Description</th>
            <th>Location</th>
            <th>Reporter</th>
            <th>Status</th>
            <th>Time</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="sosTableBody">
        @foreach (var sos in Model)
        {
            <tr id="sos-@sos.Id">
                <td>@sos.CustomerName</td>
                <td>@sos.EmergencyType</td>
                <td>@sos.AnimalType</td>
                <td>@sos.AnimalCondition</td>
                <td>@sos.Description</td>
                <td>@sos.Location</td>
                <td>@sos.ReporterName<br>@sos.ReporterPhone<br>@sos.ReporterEmail</td>
                <td class="status">@sos.Status</td>
                <td>@sos.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>
    @if (sos.Status == "Contacted")
    {
        <form method="post" asp-action="MarkDone" asp-controller="SOS">
            <input type="hidden" name="id" value="@sos.Id" />
            <button class="btn btn-success btn-sm">Mark as Done</button>
        </form>
    }
    else if (sos.Status == "Pending")
    {
        <span class="text-muted">Waiting</span>
    }
    else
    {
        <span class="text-success">Completed</span>
    }
</td>

            </tr>
        }
    </tbody>
</table>


<!-- Alerts Section -->
<div id="alerts" class="mt-4"></div>

<!-- SignalR script -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/sosHub").build();

    connection.on("ReceiveSOS", (userName, address, message, sosId) => {
        const alertDiv = document.createElement("div");
        alertDiv.className = "alert alert-danger";
        alertDiv.innerHTML = `<b>🚨 New SOS!</b><br><strong>${userName}</strong><br>📍 ${address}<br>${message}`;
        document.getElementById("alerts").prepend(alertDiv);
        new Audio("/sounds/alert.mp3").play();

        const tbody = document.getElementById("sosTableBody");
        if (!document.getElementById(`sos-${sosId}`)) {
            const tr = document.createElement("tr");
            tr.id = `sos-${sosId}`;
            tr.innerHTML = `
                <td>${userName}</td>
                <td>${address}</td>
                <td>${message}</td>
                <td class="status">Pending</td>
                <td>${new Date().toLocaleString()}</td>
                <td><button class="btn btn-sm btn-danger delete-btn" data-id="${sosId}">🗑 Delete</button></td>
            `;
            tbody.prepend(tr);
        }
    });

    connection.on("SOSUpdated", (sosId, newStatus) => {
        const row = document.getElementById(`sos-${sosId}`);
        if (row) {
            row.querySelector(".status").innerText = newStatus;
        }
    });

    connection.start().catch(err => console.error(err));

    // 🧹 Delete button functionality
    document.addEventListener("click", async (e) => {
        if (e.target.classList.contains("delete-btn")) {
            const sosId = e.target.dataset.id;
            if (confirm("Are you sure you want to delete this SOS request?")) {
                const response = await fetch(`/SOS/Delete/${sosId}`, { method: "POST" });
                if (response.ok) {
                    document.getElementById(`sos-${sosId}`).remove();
                } else {
                    alert("Failed to delete SOS request.");
                }
            }
        }
    });
</script>
