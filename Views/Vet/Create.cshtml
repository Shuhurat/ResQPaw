@model ResQPaw.Models.Vet

@{
    ViewData["Title"] = "Create Vet";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-2">
        <label>Name *</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Specialty *</label>
        <input asp-for="Specialty" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Species *</label>
        <input asp-for="Species" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Clinic *</label>
        <input asp-for="VetClinic" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Location *</label>
        <input asp-for="Location" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Availability *</label>
        <input asp-for="Availability" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Phone *</label>
        <input asp-for="Phone" class="form-control" required />
    </div>

    <div class="form-group mb-2">
        <label>Email *</label>
        <input asp-for="Email" class="form-control" type="email" required />
    </div>

    <div class="form-group mb-2">
        <label>Experience (Years)</label>
        <input asp-for="ExperienceYears" class="form-control" type="number" min="0" />
    </div>

    <div class="form-group mb-2">
        <label>Services (comma-separated)</label>
        <input asp-for="Services" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Rating</label>
        <input asp-for="Rating" class="form-control" type="number" step="0.1" min="0" max="5" />
    </div>

    <div class="form-group mb-2">
        <label>Profile Photo URL</label>
        <input asp-for="ProfilePhotoUrl" class="form-control" type="url" />
    </div>

    <div class="form-group mb-2 form-check">
        <input asp-for="EmergencyService" class="form-check-input" type="checkbox" />
        <label asp-for="EmergencyService" class="form-check-label">Emergency Service</label>
    </div>

    <div class="form-group mb-2">
        <label>Website</label>
        <input asp-for="Website" class="form-control" type="url" />
    </div>

    <div class="form-group mb-2">
        <label>Languages Spoken</label>
        <input asp-for="LanguagesSpoken" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>