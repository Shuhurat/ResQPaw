@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "SOS Notifications";
}

@model List<ResQPaw.Models.SOSViewModel>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResQPaw</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Notifications.css" asp-append-version="true" />
</head>

<body class="min-h-screen emergency-dashboard-bg">
    <div class="min-h-screen">
        <!-- Main Container -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Header Section - Centered -->
            <div class="mb-8 text-center">
                <h1 class="dashboard-title">
                    Emergency SOS Dashboard
                </h1>
                <p class="dashboard-subtitle">
                    Manage and track all animal emergency requests
                </p>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="stats-card">
                    <div class="stats-icon pending">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stats-content">
                        <div class="stats-number">@Model.Count(s => s.Status == "Pending")</div>
                        <div class="stats-label">Pending Requests</div>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="stats-icon contested">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stats-content">
                        <div class="stats-number">0</div>
                        <div class="stats-label">Contested</div>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="stats-icon completed">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stats-content">
                        <div class="stats-number">@Model.Count(s => s.Status == "Completed")</div>
                        <div class="stats-label">Completed</div>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="stats-icon total">
                        <i class="fas fa-list-alt"></i>
                    </div>
                    <div class="stats-content">
                        <div class="stats-number">@Model.Count</div>
                        <div class="stats-label">Total Emergencies</div>
                    </div>
                </div>
            </div>

            <!-- Alert Container -->
            <div id="alert-container" class="mb-6"></div>

            <!-- Recent Emergency Requests Section - Full Height Table -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden table-container">
                <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 text-center">
                    <h2 class="section-title">
                        Recent Emergency Requests
                    </h2>
                </div>

                <!-- Table Container with Fixed Height and Scroll -->
                <div class="table-wrapper">
                    <table class="w-full">
                        <thead class="bg-gray-50 sticky-top">
                            <tr>
                                <th class="table-header">CUSTOMER</th>
                                <th class="table-header">REPORTER NAME</th>
                                <th class="table-header">PHONE</th>
                                <th class="table-header">EMAIL</th>
                                <th class="table-header">ANIMAL TYPE</th>
                                <th class="table-header">CONDITION</th>
                                <th class="table-header">EMERGENCY</th>
                                <th class="table-header">LOCATION</th>
                                <th class="table-header">MESSAGE</th>
                                <th class="table-header">STATUS</th>
                                <th class="table-header">TIME</th>
                            </tr>
                        </thead>
                        <tbody id="sosTableBody" class="bg-white divide-y divide-gray-200">
                            @foreach (var sos in Model)
                            {
                                <tr class="table-row hover:bg-gray-50 transition-colors duration-200">
                                    <td class="table-cell">
                                        <div class="customer-info">
                                            <div class="customer-email">@sos.CustomerName</div>
                                        </div>
                                    </td>
                                    <td class="table-cell">
                                        <span class="reporter-name">@sos.ReporterName</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="phone-number">@sos.ReporterPhone</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="email-address">@sos.ReporterEmail</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="animal-type-badge">@sos.AnimalType</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="condition-text">@sos.AnimalCondition</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="emergency-type-badge">@sos.EmergencyType</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="location-text">@sos.Location</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="message-text" title="@sos.Description">@sos.Description</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="status-badge @(sos.Status?.ToLower() ?? "pending")">@sos.Status</span>
                                    </td>
                                    <td class="table-cell">
                                        <span class="timestamp">@sos.CreatedAt.ToString("MM/dd/yyyy h:mm tt")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Notifications.js" asp-append-version="true"></script>
</body>

</html>