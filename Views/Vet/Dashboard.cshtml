@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Vet Dashboard";
}

<!-- Hero -->
<div class="bg-light rounded-3 p-4 p-md-5 mb-4 border">
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
        <div>
            <h2 class="mb-1">Vet Dashboard</h2>
            <p class="text-muted mb-0">Welcome, <strong>@User.Identity?.Name</strong> — manage alerts, appointments, and the directory.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true) {
          <div class="alert alert-info">
            In ServiceProvider? @User.IsInRole("ServiceProvider")
          </div>
        }
        <div class="d-flex flex-wrap gap-2">
            <!-- Manage Appointments (NEW) -->
            @if (User.IsInRole("ServiceProvider") || User.IsInRole("Admin")) {
              <a class="btn btn-success" asp-controller="Appointment" asp-action="Manage">
                <i class="bi bi-calendar-check me-1"></i> Manage Appointments
              </a>
            }
            <!-- Manage Vet Directory -->
            <a asp-controller="Vet" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-person-badge me-1"></i> Manage Vet Directory
            </a>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3">

    <!-- SOS Status (ServiceProvider) -->
    @if (User.IsInRole("ServiceProvider"))
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3"
                             style="width:44px;height:44px;font-weight:700;">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0">SOS Status</h5>
                            <small class="text-muted">Monitor latest emergencies</small>
                        </div>
                    </div>
                    <p class="text-muted mb-3">View incoming SOS alerts and track their status in real time.</p>
                    <div class="mt-auto">
                        <a class="btn btn-outline-danger w-100"
                           asp-controller="Vet" asp-action="Notifications">
                            <i class="bi bi-bell me-1"></i> Open SOS Status
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SOS Alerts (Vet role, if you keep it) -->
    @if (User.IsInRole("Vet"))
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center me-3"
                             style="width:44px;height:44px;font-weight:700;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0">SOS Alerts</h5>
                            <small class="text-muted">Incoming alert center</small>
                        </div>
                    </div>
                    <p class="text-muted mb-3">Review and respond to active SOS alerts assigned to you.</p>
                    <div class="mt-auto">
                        <a class="btn btn-outline-warning w-100"
                           asp-controller="Vet" asp-action="Notifications">
                            <i class="bi bi-bell me-1"></i> View Alerts
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SOS Dashboard -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                         style="width:44px;height:44px;font-weight:700;">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">SOS Dashboard</h5>
                        <small class="text-muted">Operations overview</small>
                    </div>
                </div>
                <p class="text-muted mb-3">Open the live SOS dashboard to accept requests and coordinate care.</p>
                <div class="mt-auto">
                    <a asp-controller="SOS" asp-action="VetDashboard" class="btn btn-outline-primary w-100">
                        <i class="bi bi-speedometer2 me-1"></i> Go to SOS Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Footer note (optional, lighter) -->
<div class="text-center text-muted small mt-4">
    &copy; 2024 PetCare Connect. All rights reserved.
</div>