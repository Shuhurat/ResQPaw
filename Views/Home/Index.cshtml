@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="bg-hero-pattern min-h-screen flex items-center justify-center relative overflow-hidden">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="absolute top-20 left-20 w-40 h-40 bg-primary/20 rounded-full blur-xl float-animation"></div>
    <div class="absolute bottom-20 right-20 w-60 h-60 bg-secondary/20 rounded-full blur-xl float-animation"
        style="animation-delay: 1s;"></div>
    <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-accent/10 rounded-full blur-2xl">
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
        <!-- Main Heading with Hover Effects -->
        <div class="mb-8">
            <h1 class="text-6xl md:text-8xl font-bold mb-6 text-hover-glow">
                <span class="gradient-text">Helping Pets</span>
                <br>
                <span class="text-white">Find Their Forever Homes</span>
            </h1>

            <!-- Subtitle with Hover Effect -->
            <p class="text-2xl md:text-3xl text-amber-100 mb-8 leading-relaxed max-w-4xl mx-auto text-hover-glow">
                ResQPaw connects rescue pets with loving families and provides emergency services
                for animals in need across Bangladesh.
            </p>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mt-8">
            <a asp-controller="Pets" asp-action="Index" class="hero-btn-primary flex items-center">
                <i class="fas fa-paw mr-3 text-2xl"></i>Find a Pet
            </a>

            <a asp-controller="LostFound" asp-action="Index" class="hero-btn-outline flex items-center">
                <i class="fas fa-search mr-3 text-2xl"></i>Report Lost Pet
            </a>
        </div>

        <!-- Stats with Hover Effects -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-16 max-w-4xl mx-auto">
            <div class="stats-card rounded-2xl p-6 text-center hover-lift">
                <div class="text-4xl font-bold text-primary mb-2 text-hover-glow">500+</div>
                <div class="text-amber-100 font-semibold text-hover-glow">Pets Rescued</div>
            </div>
            <div class="stats-card rounded-2xl p-6 text-center hover-lift">
                <div class="text-4xl font-bold text-accent mb-2 text-hover-glow">300+</div>
                <div class="text-amber-100 font-semibold text-hover-glow">Happy Adoptions</div>
            </div>
            <div class="stats-card rounded-2xl p-6 text-center hover-lift">
                <div class="text-4xl font-bold text-secondary mb-2 text-hover-glow">24/7</div>
                <div class="text-amber-100 font-semibold text-hover-glow">Emergency Service</div>
            </div>
            <div class="stats-card rounded-2xl p-6 text-center hover-lift">
                <div class="text-4xl font-bold text-primary mb-2 text-hover-glow">50+</div>
                <div class="text-amber-100 font-semibold text-hover-glow">Vet Partners</div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="bg-feature-pattern py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-white/90 backdrop-blur-sm"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <h2 class="text-5xl md:text-6xl font-bold text-gray-800 mb-6 text-hover-glow">
                How <span class="gradient-text">ResQPaw</span> Helps
            </h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed text-hover-glow">
                We provide comprehensive services for pet rescue, care, and adoption with a dedicated
                network of professionals and volunteers across Bangladesh.
            </p>
        </div>

        <!-- Features Grid - Larger Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Pet Adoption -->
            <div class="feature-card feature-card-lg rounded-3xl p-6 hover-lift group">
                <div class="relative overflow-hidden rounded-2xl mb-6">
                    <img src="https://images.unsplash.com/photo-1535930749574-1399327ce78f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                        alt="Pet Adoption"
                        class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <div class="absolute bottom-4 left-4">
                        <div
                            class="w-12 h-12 bg-primary rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <i class="fas fa-home text-white text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="feature-content">
                    <h3
                        class="text-2xl font-bold text-gray-800 mb-3 group-hover:text-primary transition-colors duration-300">
                        Pet Adoption</h3>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                        Find your perfect companion from our network of shelters across Dhaka, Chittagong, and Sylhet.
                        Local breeds and rescued pets available.
                    </p>
                    <a href="#"
                        class="inline-flex items-center text-primary font-semibold group-hover:translate-x-2 transition-all duration-300 mt-auto">
                        Learn More
                        <i class="fas fa-arrow-right ml-2 group-hover:ml-3 transition-all duration-300"></i>
                    </a>
                </div>
            </div>

            <!-- Lost & Found -->
            <div class="feature-card feature-card-lg rounded-3xl p-6 hover-lift group">
                <div class="relative overflow-hidden rounded-2xl mb-6">
                    <img src="https://images.unsplash.com/photo-1596272875729-ed2ff7d6d9c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                        alt="Lost & Found"
                        class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <div class="absolute bottom-4 left-4">
                        <div
                            class="w-12 h-12 bg-accent rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <i class="fas fa-search text-white text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="feature-content">
                    <h3
                        class="text-2xl font-bold text-gray-800 mb-3 group-hover:text-accent transition-colors duration-300">
                        Lost & Found</h3>
                    <p class="text-gray-600 mb-4 leading-relaxed">
