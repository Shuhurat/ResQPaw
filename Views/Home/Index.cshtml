                </a>

                <a href="#"
                    class="glass-btn-primary px-10 py-5 rounded-2xl text-xl font-semibold transition-all duration-300 hover:scale-105 flex items-center bg-amber-500 border-amber-400">
                    <i class="fas fa-heart mr-3 text-2xl"></i>Donate Now
                </a>
            </div>

            <!-- Additional Info -->
            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 text-amber-100">
                <div class="text-center group">
                    <div
                        class="glass-icon p-4 rounded-2xl inline-block mb-4 group-hover:scale-110 transition-transform duration-300">
                        <i class="fas fa-home text-3xl text-amber-200"></i>
                    </div>
                    <h4 class="font-semibold mb-2 text-lg text-hover-glow">Adopt</h4>
                    <p class="text-sm text-hover-glow">Give a pet a loving forever home</p>
                </div>
                <div class="text-center group">
                    <div
                        class="glass-icon p-4 rounded-2xl inline-block mb-4 group-hover:scale-110 transition-transform duration-300">
                        <i class="fas fa-hand-holding-heart text-3xl text-amber-200"></i>
                    </div>
                    <h4 class="font-semibold mb-2 text-lg text-hover-glow">Foster</h4>
                    <p class="text-sm text-hover-glow">Provide temporary care for pets in need</p>
                </div>
                <div class="text-center group">
                    <div
                        class="glass-icon p-4 rounded-2xl inline-block mb-4 group-hover:scale-110 transition-transform duration-300">
