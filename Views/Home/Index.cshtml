            <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
                <a href="#"
                    class="glass-btn-outline px-10 py-5 rounded-2xl text-xl font-semibold transition-all duration-300 hover:scale-105 flex items-center text-white border-white/50">
