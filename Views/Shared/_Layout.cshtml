@using Microsoft.AspNetCore.Identity
@inject SignInManager<ResQPaw.Models.ApplicationUser> SignInManager
@inject UserManager<ResQPaw.Models.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResQPaw</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#f59e0b',
                        secondary: '#ef4444',
                        accent: '#10b981',
                        dark: '#1f2937',
                        light: '#f8fafc'
                    },
                    backgroundImage: {
                        'gradient-radial': 'radial-gradient(var(--tw-gradient-stops))',
                        'hero-pattern': "url('https://images.unsplash.com/photo-1548199973-03cce0bbc87b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80')",
                        'feature-pattern': "url('https://images.unsplash.com/photo-1450778869180-41d0601e046e?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80')",
                        'pets-pattern': "url('https://images.unsplash.com/photo-1514984879728-be0aff75a6e8?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80')"
                    },
                    backdropBlur: {
                        'xs': '2px',
                    },
                    boxShadow: {
                        'glass': '0 8px 32px 0 rgba(31, 38, 135, 0.37)',
                        '3xl': '0 35px 60px -15px rgba(0, 0, 0, 0.3)',
                    }
                }
            }
        }
    </script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-gradient-to-br from-amber-50 to-orange-100 min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="glass-nav fixed top-0 w-full z-50 transition-all duration-300 hover:bg-white/90">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <div class="logo flex items-center group">
                    <div class="relative">
                        <div
                            class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center mr-3 shadow-lg group-hover:scale-110 transition-transform duration-300">
                            <i class="fas fa-paw text-white text-xl"></i>
                        </div>
                        <div class="sparkle absolute -top-1 -right-1 w-4 h-4 bg-yellow-300 rounded-full"></div>
                    </div>
                    <h1 class="text-amber-600 text-2xl font-bold">ResQPaw</h1>
                </div>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-8">
                    <a asp-controller="Home" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-all duration-300 font-semibold hover:scale-105">
                        Home
                    </a>
                    <a asp-controller="Pets" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-all duration-300 font-semibold hover:scale-105">
                        Find Pets
                    </a>
                    <a asp-controller="LostFound" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-all duration-300 font-semibold hover:scale-105">
                        Lost & Found
                    </a>
                    <a asp-controller="Vets" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-all duration-300 font-semibold hover:scale-105">
                        Veterinarians
                    </a>
                    <a asp-controller="Resources" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-all duration-300 font-semibold hover:scale-105">
                        Resources
                    </a>
                    <a asp-controller="Home" asp-action="About"
                        class="nav-link text-dark hover:text-primary transition-all duration-300 font-semibold hover:scale-105">
                        About Us
                    </a>
                </div>

                <!-- Right Section -->
                <div class="flex items-center space-x-4">
                    <!-- Role-based Dashboard -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard"
                                class="glass-btn-primary px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105">
                                <i class="fas fa-shield-alt mr-2"></i>Admin Dashboard
                            </a>
                        }
                        else if (User.IsInRole("ServiceProvider"))
                        {
                            <a asp-controller="Vet" asp-action="Dashboard"
                                class="glass-btn-accent px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105">
                                <i class="fas fa-stethoscope mr-2"></i>Service Dashboard
                            </a>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <a asp-controller="Customer" asp-action="Dashboard"
                                class="glass-btn-primary px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105">
                                <i class="fas fa-user mr-2"></i>My Dashboard
                            </a>
                        }
                    }

                    <!-- Vet Notification -->
                    <div class="hidden" id="vetNotificationArea">
                        <div class="relative">
                            <button id="notificationDropdown"
                                class="glass-icon p-3 rounded-xl text-dark hover:text-primary transition-all duration-300 hover:scale-110">
                                <i class="fas fa-bell text-xl"></i>
                                <span id="notificationCount" class="absolute -top-1 -right-1 bg-secondary text-white text-xs rounded-full 
                                             h-6 w-6 flex items-center justify-center animate-pulse">0</span>
                            </button>

                            <!-- Notification Dropdown -->
                            <div id="notificationList"
                                class="absolute right-0 mt-2 w-96 glass-card rounded-xl shadow-glass hidden overflow-hidden z-50">
                                <div class="p-4 text-center text-gray-500">
                                    No new SOS alerts
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Auth Buttons -->
                    <div class="flex items-center space-x-3">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout"
                                asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit"
                                    class="glass-btn-secondary px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105">
                                    <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login"
                                class="glass-btn-primary px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105">
                                <i class="fas fa-sign-in-alt mr-2"></i>Login
                            </a>
                            <a asp-area="Identity" asp-page="/Account/Register"
                                class="glass-btn-outline px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105">
                                <i class="fas fa-user-plus mr-2"></i>Register
                            </a>
                        }
                    </div>
                </div>

                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button type="button" id="mobileMenuButton"
                        class="glass-icon p-3 rounded-xl text-dark hover:text-primary transition-colors duration-300">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden md:hidden py-4 border-t border-white/20">
                <div class="flex flex-col space-y-4">
                    <a asp-controller="Home" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-colors py-2">Home</a>
                    <a asp-controller="Pets" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-colors py-2">Find Pets</a>
                    <a asp-controller="LostFound" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-colors py-2">Lost & Found</a>
                    <a asp-controller="Vets" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-colors py-2">Veterinarians</a>
                    <a asp-controller="Resources" asp-action="Index"
                        class="nav-link text-dark hover:text-primary transition-colors py-2">Resources</a>
                    <a asp-controller="Home" asp-action="About"
                        class="nav-link text-dark hover:text-primary transition-colors py-2">About Us</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow pt-20">
        @RenderBody()
    </main>

    <!-- SOS Floating Button -->
    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
    {
        <a asp-controller="SOS" asp-action="Send" class="sos-btn-round fixed bottom-8 right-8 z-40">
            <span class="sos-pulse"></span>
            <span class="sos-text">SOS</span>
            <i class="fas fa-ambulance sos-icon"></i>
        </a>
    }

    <!-- Footer -->
    <footer class="glass-footer relative overflow-hidden">
        <div class="absolute inset-0 bg-dark/90 backdrop-blur-md"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- Brand -->
                <div class="col-span-1">
                    <div class="logo flex items-center mb-6">
                        <div class="relative">
                            <div
                                class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center mr-3 shadow-lg">
                                <i class="fas fa-paw text-white text-xl"></i>
                            </div>
                            <div class="sparkle absolute -top-1 -right-1 w-4 h-4 bg-yellow-300 rounded-full"></div>
                        </div>
                        <h1 class="text-amber-600 text-2xl font-bold">ResQPaw</h1>
                    </div>
                    <p class="text-gray-300 mb-6 leading-relaxed">
                        Connecting rescue pets with loving families across Bangladesh.
                        Providing emergency services and veterinary care.
                    </p>
                    <div class="flex space-x-4">
                        <a href="#"
                            class="glass-icon p-3 text-gray-300 hover:text-primary transition-all duration-300 hover:scale-110">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#"
                            class="glass-icon p-3 text-gray-300 hover:text-primary transition-all duration-300 hover:scale-110">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#"
                            class="glass-icon p-3 text-gray-300 hover:text-primary transition-all duration-300 hover:scale-110">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div>
                    <h3 class="text-lg font-semibold text-primary mb-6">Quick Links</h3>
                    <ul class="space-y-3">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-link">Home</a></li>
                        <li><a asp-controller="Pets" asp-action="Index" class="footer-link">Adopt a Pet</a></li>
                        <li><a asp-controller="LostFound" asp-action="Index" class="footer-link">Lost & Found</a></li>
                        <li><a asp-controller="Vets" asp-action="Index" class="footer-link">Veterinarians</a></li>
                        <li><a asp-controller="Resources" asp-action="Index" class="footer-link">Resources</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="footer-link">About Us</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div>
                    <h3 class="text-lg font-semibold text-primary mb-6">Contact Us</h3>
                    <div class="space-y-3 text-gray-300">
                        <p class="flex items-center"><i class="fas fa-map-marker-alt mr-3 text-primary"></i>Dhaka,
                            Bangladesh</p>
                        <p class="flex items-center"><i class="fas fa-phone mr-3 text-primary"></i>+880 1234-567890</p>
                        <p class="flex items-center"><i class="fas fa-envelope mr-3 text-primary"></i>info@resqpaw.org
                        </p>
                    </div>
                </div>

                <!-- Newsletter -->
                <div>
                    <h3 class="text-lg font-semibold text-primary mb-6">Newsletter</h3>
                    <p class="text-gray-300 mb-4">Subscribe for updates on pets and rescue stories.</p>
                    <div class="flex glass-input-group">
                        <input type="email" placeholder="Your email" class="glass-input">
                        <button class="glass-btn-primary rounded-l-none">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-600 mt-8 pt-8 text-center text-gray-300">
                <p>&copy; 2025 ResQPaw. All rights reserved. Made with ❤️ for animals in Bangladesh.</p>
            </div>
        </div>
    </footer>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed top-24 right-4 z-50 space-y-2"></div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Mobile menu functionality
        document.addEventListener('DOMContentLoaded', function () {
            const mobileMenuButton = document.getElementById('mobileMenuButton');
            const mobileMenu = document.getElementById('mobileMenu');

            if (mobileMenuButton && mobileMenu) {
                mobileMenuButton.addEventListener('click', function () {
                    mobileMenu.classList.toggle('hidden');
                    const icon = mobileMenuButton.querySelector('i');
                    if (icon.classList.contains('fa-bars')) {
                        icon.classList.replace('fa-bars', 'fa-times');
                    } else {
                        icon.classList.replace('fa-times', 'fa-bars');
                    }
                });
            }

            // Notification dropdown functionality
            const notificationDropdown = document.getElementById('notificationDropdown');
            const notificationList = document.getElementById('notificationList');

            if (notificationDropdown && notificationList) {
                notificationDropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                    notificationList.classList.toggle('hidden');
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function () {
                    notificationList.classList.add('hidden');
                });
            }

            // Initialize SignalR for vets - USING PREVIOUS BACKEND LOGIC
            const isVet = '@(User.IsInRole("ServiceProvider") ? "true" : "false")';

            if (isVet !== 'true') return; // only run for vets

            // show bell area (in case it's hidden)
            const notificationArea = document.getElementById("vetNotificationArea");
            if (notificationArea) notificationArea.classList.remove("hidden");

            // prepare connection (exact hub path must match Program.cs)
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/sosHub")
                .withAutomaticReconnect()
                .build();

            // ensure badge starts with existing value (if server rendered any)
            let notificationCount = parseInt(document.getElementById('notificationCount')?.innerText || '0', 10);

            // handler - register BEFORE starting connection
            connection.on("ReceiveSOS", (customerName, address, message) => {
                try {
                    console.log("SOS received:", customerName, address, message);

                    // increment badge
                    notificationCount += 1;
                    const badge = document.getElementById("notificationCount");
                    if (badge) badge.innerText = notificationCount;

                    // prepend to dropdown
                    const list = document.getElementById("notificationList");
                    if (list) {
                        if (list.children.length === 1 && list.children[0].classList.contains("text-gray-500")) {
                            list.innerHTML = "";
                        }
                        const newItem = document.createElement("div");
                        newItem.className = "p-4 border-b border-white/10 hover:bg-white/5 transition-colors cursor-pointer";
                        newItem.innerHTML = `<strong>🚨 ${customerName}</strong><br>${address}<br>${message}`;
                        list.prepend(newItem);
                    }

                    // show toast
                    showTailwindToast(customerName, address, message);
                } catch (ex) {
                    console.error("Error in ReceiveSOS handler:", ex);
                }
            });

            // start connection, join group, then load unseen items
            connection.start()
                .then(async () => {
                    console.log("Connected to SOSHub");
                    try {
                        await connection.invoke("JoinVetGroup");
                        console.log("Joined 'Vets' group");
                    } catch (e) {
                        console.warn("JoinVetGroup failed:", e);
                    }

                    // fetch unseen alerts that arrived while vet was offline
                    try {
                        const res = await fetch('/Vet/UnseenSOS', { method: 'GET', headers: { 'Accept': 'application/json' } });
                        if (res.ok) {
                            const arr = await res.json();
                            if (Array.isArray(arr) && arr.length > 0) {
                                const list = document.getElementById("notificationList");
                                if (list) list.innerHTML = ""; // clear placeholder
                                arr.forEach(item => {
                                    // add each unseen alert to dropdown
                                    const div = document.createElement("div");
                                    div.className = "p-4 border-b border-white/10 hover:bg-white/5 transition-colors cursor-pointer";
                                    div.innerHTML = `<strong>🚨 ${item.customerName}</strong><br>${item.address}<br>${item.message}`;
                                    list.prepend(div);
                                });

                                // increase badge by count of unseen
                                notificationCount += arr.length;
                                const badge = document.getElementById("notificationCount");
                                if (badge) badge.innerText = notificationCount;
                            }
                        } else {
                            // likely 401 if vet not authorized — safe to ignore, but log
                            console.warn("UnseenSOS fetch returned", res.status);
                        }
                    } catch (err) {
                        console.error("Failed to load unseen SOS:", err);
                    }
                })
                .catch(err => console.error("SignalR start error:", err));
        });

        function showTailwindToast(customerName, address, message) {
            const toastContainer = document.getElementById('toastContainer');
            if (!toastContainer) return;

            const toastId = 'toast-' + Date.now();
            const toast = document.createElement('div');
            toast.id = toastId;
            toast.className = 'glass-card bg-red-500/90 backdrop-blur-md border-l-4 border-red-400 p-4 rounded-xl shadow-glass transform transition-all duration-300 max-w-sm';
            toast.innerHTML = `
                <div class="flex items-start space-x-3">
                    <div class="flex-shrink-0">
                        <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center">
                            <i class="fas fa-ambulance text-red-500 text-sm"></i>
                        </div>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-white">Emergency Alert</h4>
                        <p class="text-white text-sm mt-1"><strong>${customerName}</strong> needs help!</p>
                        <p class="text-white/80 text-xs mt-1">${address}</p>
                        <p class="text-white/70 text-xs mt-1">${message}</p>
                    </div>
                    <button onclick="document.getElementById('${toastId}').remove()" 
                            class="flex-shrink-0 text-white/70 hover:text-white transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;

            toastContainer.appendChild(toast);

            // Auto remove after 8 seconds
            setTimeout(() => {
                const existingToast = document.getElementById(toastId);
                if (existingToast) {
                    existingToast.style.opacity = '0';
                    existingToast.style.transform = 'translateX(100%)';
                    existingToast.style.transition = 'all 0.5s ease';
                    setTimeout(() => existingToast.remove(), 500);
                }
            }, 8000);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>